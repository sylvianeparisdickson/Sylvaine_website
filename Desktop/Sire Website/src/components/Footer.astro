---
<footer class="bg-charcoal border-t border-white/10 py-8 sm:py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8">
      
      <!-- 18+ Disclaimer -->
      <div class="text-center md:text-left">
        <p class="text-rose-gold-light font-semibold text-xs sm:text-sm uppercase tracking-wider mb-1 sm:mb-2">
          18+ Adult Content
        </p>
        <p class="text-white/50 text-xs sm:text-sm font-sans">
          This website contains mature content. By continuing, you confirm you are 18 years or older.
        </p>
      </div>

      <!-- Copyright -->
      <div class="text-center">
        <p class="text-white/40 text-xs sm:text-sm font-sans">
          © 2024 Sirewrites. All rights reserved.
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex items-center space-x-4 sm:space-x-6">
        {socialLinks.map((social) => (
          <a
            href={social.href}
            aria-label={social.name}
            class="text-white/60 hover:text-rose-gold-light transition-colors duration-300"
          >
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d={social.icon} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom disclaimer line -->
    <div class="mt-6 sm:mt-8 pt-6 sm:pt-8 border-t border-white/5 text-center">
      <p class="text-white/30 text-[10px] sm:text-xs font-sans">
        All characters and events in this website are fictional. Any resemblance to actual persons, living or dead, is purely coincidental.
      </p>
    </div>
  </div>
</footer>
