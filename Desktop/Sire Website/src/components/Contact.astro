---
---
<section class="min-h-screen relative overflow-hidden">
  <!-- Hero Background -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=1920&h=1080&fit=crop"
      alt="Writing background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-charcoal/90 via-charcoal/80 to-charcoal"></div>
  </div>

  <div class="relative z-10 pt-24 sm:pt-32 pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Page Header -->
      <div class="text-center mb-10 sm:mb-12 lg:mb-16">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl text-white mb-3 sm:mb-4">
          Get in Touch
        </h1>
        <div class="w-20 sm:w-24 lg:w-32 h-1 bg-rose-gold-gradient mx-auto rounded-full mb-4 sm:mb-6"></div>
        <p class="text-white/70 text-base sm:text-lg lg:text-xl font-sans max-w-2xl mx-auto">
          Have a question, feedback, or just want to say hello? I'd love to hear from you.
        </p>
      </div>

      <!-- Contact Content Grid -->
      <div class="grid lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-start">
        
        <!-- Contact Info Cards -->
        <div class="space-y-4 sm:space-y-6">
          <!-- Email Card -->
          <div class="bg-white/5 border border-rose-gold/30 rounded-xl sm:rounded-2xl p-4 sm:p-6 backdrop-blur-sm hover:border-rose-gold/50 transition-all duration-300">
            <div class="flex items-start space-x-3 sm:space-x-4">
              <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-rose-gold/20 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-rose-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-semibold text-base sm:text-lg mb-1 font-serif">Email</h3>
                <p class="text-white/60 font-sans text-sm sm:text-base">sirew7473@gmail.com</p>
              </div>
            </div>
          </div>

          <!-- Social Media Card -->
          <div class="bg-white/5 border border-rose-gold/30 rounded-xl sm:rounded-2xl p-4 sm:p-6 backdrop-blur-sm hover:border-rose-gold/50 transition-all duration-300">
            <h3 class="text-white font-semibold text-base sm:text-lg mb-3 sm:mb-4 font-serif">Connect on Social</h3>
            <div class="flex space-x-3 sm:space-x-4">
              <a href="#instagram" class="w-9 h-9 sm:w-10 sm:h-10 bg-rose-gold/20 rounded-full flex items-center justify-center text-rose-gold-light hover:bg-rose-gold hover:text-charcoal transition-all duration-300" aria-label="Instagram">
                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
              <a href="#tiktok" class="w-9 h-9 sm:w-10 sm:h-10 bg-rose-gold/20 rounded-full flex items-center justify-center text-rose-gold-light hover:bg-rose-gold hover:text-charcoal transition-all duration-300" aria-label="TikTok">
                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 2.93-1.43-.13-2.8-.72-3.91-1.66-1.12-.94-1.92-2.24-2.16-3.69-.26-1.61.09-3.29.89-4.71.77-1.39 1.97-2.5 3.41-3.11 1.43-.61 3.03-.65 4.51-.18.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.25.71-.24 1.5.03 2.21.32.81.96 1.47 1.76 1.81.81.34 1.74.35 2.53-.03.79-.38 1.4-1.09 1.63-1.91.22-.81.2-1.67.01-2.48-.02-5.22-.01-10.44-.01-15.66z"/></svg>
              </a>
              <a href="#goodreads" class="w-9 h-9 sm:w-10 sm:h-10 bg-rose-gold/20 rounded-full flex items-center justify-center text-rose-gold-light hover:bg-rose-gold hover:text-charcoal transition-all duration-300" aria-label="Goodreads">
                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm-1-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm5 7h-2v-3c0-1.1-.9-2-2-2v-2c2.21 0 4 1.79 4 4v3z"/></svg>
              </a>
            </div>
          </div>

          <!-- Response Time Card -->
          <div class="bg-white/5 border border-rose-gold/30 rounded-xl sm:rounded-2xl p-4 sm:p-6 backdrop-blur-sm hover:border-rose-gold/50 transition-all duration-300">
            <div class="flex items-start space-x-3 sm:space-x-4">
              <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-rose-gold/20 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-rose-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-semibold text-base sm:text-lg mb-1 font-serif">Response Time</h3>
                <p class="text-white/60 font-sans text-sm sm:text-base">I typically respond within 24-48 hours</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 lg:p-10 backdrop-blur-sm">
      <form class="space-y-4 sm:space-y-6" onsubmit="event.preventDefault();">
        <!-- Name -->
        <div>
          <label for="name" class="block text-white/80 text-xs sm:text-sm font-medium mb-2 font-sans uppercase tracking-wider">
            Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-3 sm:px-4 py-2 sm:py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-rose-gold focus:ring-2 focus:ring-rose-gold/30 transition-all duration-300 font-sans text-sm sm:text-base"
            placeholder="Your name"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-white/80 text-xs sm:text-sm font-medium mb-2 font-sans uppercase tracking-wider">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-3 sm:px-4 py-2 sm:py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-rose-gold focus:ring-2 focus:ring-rose-gold/30 transition-all duration-300 font-sans text-sm sm:text-base"
            placeholder="your@email.com"
          />
        </div>

        <!-- Subject -->
        <div>
          <label for="subject" class="block text-white/80 text-xs sm:text-sm font-medium mb-2 font-sans uppercase tracking-wider">
            Subject
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            class="w-full px-3 sm:px-4 py-2 sm:py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-rose-gold focus:ring-2 focus:ring-rose-gold/30 transition-all duration-300 font-sans text-sm sm:text-base"
            placeholder="What's this about?"
          />
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="block text-white/80 text-xs sm:text-sm font-medium mb-2 font-sans uppercase tracking-wider">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="5 sm:rows-6"
            required
            class="w-full px-3 sm:px-4 py-2 sm:py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-rose-gold focus:ring-2 focus:ring-rose-gold/30 transition-all duration-300 font-sans resize-none text-sm sm:text-base"
            placeholder="Your message..."
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-rose-gold-gradient text-charcoal px-6 sm:px-8 py-3 sm:py-4 rounded-full font-semibold text-sm sm:text-base uppercase tracking-wider hover:shadow-rose-glow transition-all duration-300 transform hover:scale-105"
        >
          Send Message
        </button>
      </form>
    </div>
      </div>
    </div>
  </div>
</section>
