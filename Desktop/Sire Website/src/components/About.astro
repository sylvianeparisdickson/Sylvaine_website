---
---
<section id="about" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-charcoal">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
      
      <!-- Author Image -->
      <div class="w-full md:w-1/2 order-2 md:order-1">
        <img
          src="/Sire.jpeg"
          alt="Sirewrites portrait"
          class="w-full max-w-sm md:max-w-md mx-auto rounded-lg shadow-xl"
        />
      </div>

      <!-- About Content -->
      <div class="w-full md:w-1/2 space-y-4 md:space-y-6 order-1 md:order-2">
        <!-- Title -->
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl xl:text-5xl text-white">
          About Sirewrites
        </h2>

        <!-- Horizontal Line -->
        <div class="w-12 sm:w-16 h-0.5 bg-rose-gold"></div>

        <!-- Description -->
        <p class="text-white/80 text-sm sm:text-base lg:text-lg font-sans leading-relaxed">
          A passionate storyteller weaving tales of romance, mystery, and everything in between. With a love for poetry and an honest approach to storytelling, I create characters and worlds that linger in your heart long after you've turned the final page.
        </p>

        <!-- Read More Link -->
        <a
          href="/about"
          class="text-rose-gold-light font-medium text-xs sm:text-sm uppercase tracking-wider hover:text-white transition-colors duration-300 inline-block"
        >
          Read more
        </a>
      </div>
    </div>
  </div>
</section>
