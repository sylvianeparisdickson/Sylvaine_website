---
const navLinks = [
  { name: 'Genres', href: '#', hasDropdown: true, items: [
    { name: 'Fantasy', href: '/fantasy' },
    { name: 'Poetry', href: '/poetry' },
    { name: 'Erotic', href: '/erotic' },
    { name: 'Thriller', href: '/thriller' },
  ]},
  { name: 'Creative Corner', href: '/creative-corner' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];

let mobileMenuOpen = false;
---
<nav class="fixed top-0 left-0 right-0 z-50 bg-charcoal/95 backdrop-blur-sm border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo / Sirewrites -->
      <div class="flex-shrink-0">
        <a href="/" class="font-serif text-xl sm:text-2xl lg:text-3xl text-rose-gold-light tracking-wide">
          Sirewrites
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <div class="hidden md:flex items-center space-x-6 lg:space-x-8">
        {navLinks.map((link) => (
          link.hasDropdown ? (
            <div class="relative group">
              <button class="text-white/80 hover:text-rose-gold-light transition-colors duration-300 font-sans text-xs sm:text-sm uppercase tracking-wider flex items-center">
                {link.name}
                <svg class="w-3 h-3 sm:w-4 sm:h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-2 w-44 sm:w-48 bg-charcoal border border-white/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform group-hover:translate-y-0 translate-y-2">
                <div class="py-2">
                  {link.items.map((item) => (
                    <a
                      href={item.href}
                      class="block px-3 sm:px-4 py-2 text-white/80 hover:text-rose-gold-light hover:bg-white/5 transition-colors font-sans text-xs sm:text-sm uppercase tracking-wider"
                    >
                      {item.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="text-white/80 hover:text-rose-gold-light transition-colors duration-300 font-sans text-xs sm:text-sm uppercase tracking-wider"
            >
              {link.name}
            </a>
          )
        ))}
      </div>

      <!-- CTA Button - Desktop -->
      <div class="hidden md:flex items-center">
        <a
          href="/contact"
          class="bg-rose-gold-gradient text-charcoal px-4 sm:px-6 py-2 sm:py-2.5 rounded-full font-semibold text-xs sm:text-sm uppercase tracking-wider hover:shadow-rose-glow transition-all duration-300 transform hover:scale-105"
        >
          Get in Touch
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center gap-3">
        <!-- Mobile CTA -->
        <a
          href="/contact"
          class="bg-rose-gold-gradient text-charcoal px-3 py-1.5 rounded-full font-semibold text-xs uppercase tracking-wider hover:shadow-rose-glow transition-all duration-300"
        >
          Contact
        </a>
        <button 
          id="mobile-menu-button"
          class="text-white hover:text-rose-gold-light transition-colors p-1"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div 
    id="mobile-menu"
    class="md:hidden bg-charcoal border-t border-white/10 transition-all duration-300 overflow-hidden"
    style="max-height: 0;"
  >
    <div class="px-4 py-4 space-y-2">
      {navLinks.map((link) => (
        link.hasDropdown ? (
          <div>
            <button 
              id="dropdown-button"
              class="w-full text-left text-white/80 hover:text-rose-gold-light transition-colors font-sans text-sm uppercase tracking-wider py-2 flex items-center justify-between"
            >
              {link.name}
              <svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div 
              id="dropdown-menu"
              class="pl-4 mt-2 space-y-2 transition-all duration-300 overflow-hidden"
              style="max-height: 0;"
            >
              {link.items.map((item) => (
                <a
                  href={item.href}
                  class="block text-white/60 hover:text-rose-gold-light transition-colors font-sans text-sm uppercase tracking-wider py-2"
                >
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="block text-white/80 hover:text-rose-gold-light transition-colors font-sans text-sm uppercase tracking-wider py-2"
          >
            {link.name}
          </a>
        )
      ))}
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const dropdownButton = document.getElementById('dropdown-button');
  const dropdownMenu = document.getElementById('dropdown-menu');
  let isMenuOpen = false;
  let isDropdownOpen = false;

  mobileMenuButton?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    if (mobileMenu) {
      mobileMenu.style.maxHeight = isMenuOpen ? '500px' : '0';
    }
  });

  dropdownButton?.addEventListener('click', () => {
    isDropdownOpen = !isDropdownOpen;
    if (dropdownMenu) {
      dropdownMenu.style.maxHeight = isDropdownOpen ? '200px' : '0';
    }
    const icon = dropdownButton?.querySelector('svg');
    icon?.classList.toggle('rotate-180');
  });
</script>

<style>
  /* Add smooth scrolling */
  html {
    scroll-behavior: smooth;
  }
</style>
