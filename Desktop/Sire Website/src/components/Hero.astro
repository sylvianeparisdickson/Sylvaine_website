<section class="pt-24 sm:pt-32 pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8 min-h-[80vh] sm:min-h-screen flex items-center justify-center relative overflow-hidden">
  <!-- Background Image with Bright Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=1920&h=1080&fit=crop"
      alt="Books and writing background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-rose-gold/30 via-champagne/40 to-rose-gold/50"></div>
  </div>

  <div class="max-w-4xl sm:max-w-5xl mx-auto w-full text-center relative z-10 px-4">
    
    <!-- Headline -->
    <h1 class="font-serif text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl text-charcoal leading-relaxed">
      Where poetry meets honesty, and every story<br />
      <span class="text-rose-gold-800 font-semibold text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl">lingers long after the last page.</span>
    </h1>
  </div>
</section>
