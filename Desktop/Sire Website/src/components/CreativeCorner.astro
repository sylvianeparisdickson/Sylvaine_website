---
---
<section class="min-h-screen bg-gradient-to-b from-cream-50 via-champagne-100 to-rose-gold-50">
  <!-- Decorative Pattern Background -->
  <div class="absolute inset-0 z-0 opacity-5">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23D4A5A5&quot; fill-opacity=&quot;0.4&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
  </div>

  <div class="relative z-10">
    <!-- Hero Section with Split Layout -->
    <div class="min-h-screen flex items-center">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <!-- Left Content -->
          <div class="space-y-8">
            <div class="inline-flex items-center gap-2 bg-terracotta/10 px-4 py-2 rounded-full">
              <span class="w-2 h-2 bg-terracotta rounded-full animate-pulse"></span>
              <span class="text-terracotta font-serif text-sm uppercase tracking-widest">Handmade with Love</span>
            </div>
            
            <h1 class="font-serif text-6xl sm:text-7xl lg:text-8xl text-charcoal leading-tight">
              Creative<br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-terracotta via-rose-gold to-champagne">Corner</span>
            </h1>
            
            <p class="text-charcoal/70 text-xl font-sans leading-relaxed max-w-lg">
              Welcome to my world of crochet artistry. Where every stitch tells a story, every creation holds a memory, and handmade beauty comes to life.
            </p>
            
            <div class="flex flex-wrap gap-4">
              <a href="#gallery" class="bg-gradient-to-r from-terracotta to-rose-gold text-white px-8 py-4 rounded-full font-semibold text-base uppercase tracking-wider hover:shadow-xl hover:shadow-terracotta/30 transition-all duration-300 transform hover:scale-105">
                Explore Gallery
              </a>
              <a href="#about" class="border-2 border-charcoal/20 text-charcoal px-8 py-4 rounded-full font-semibold text-base uppercase tracking-wider hover:bg-charcoal/5 transition-all duration-300">
                My Story
              </a>
            </div>

            <!-- Quick Stats -->
            <div class="flex gap-8 pt-8 border-t border-charcoal/10">
              <div>
                <div class="font-serif text-4xl text-terracotta">50+</div>
                <div class="text-charcoal/60 text-sm uppercase tracking-wider">Projects</div>
              </div>
              <div>
                <div class="font-serif text-4xl text-rose-gold">5+</div>
                <div class="text-charcoal/60 text-sm uppercase tracking-wider">Years</div>
              </div>
              <div>
                <div class="font-serif text-4xl text-champagne">∞</div>
                <div class="text-charcoal/60 text-sm uppercase tracking-wider">Love</div>
              </div>
            </div>
          </div>

          <!-- Right Image with Decorative Elements -->
          <div class="relative">
            <div class="absolute -top-8 -left-8 w-full h-full bg-gradient-to-br from-terracotta/20 to-rose-gold/20 rounded-3xl transform rotate-3"></div>
            <div class="absolute -top-4 -left-4 w-full h-full bg-gradient-to-br from-champagne/30 to-cream/50 rounded-3xl transform -rotate-2"></div>
            <img
              src="https://images.unsplash.com/photo-1605289355680-75fb41239154?w=800&h=900&fit=crop"
              alt="Crochet artistry"
              class="relative rounded-3xl shadow-2xl w-full object-cover aspect-[4/5]"
            />
            
            <!-- Floating Badge -->
            <div class="absolute -bottom-6 -right-6 bg-white rounded-2xl shadow-xl p-6 border border-cream-200">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-terracotta to-rose-gold rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-charcoal">Made with Love</div>
                  <div class="text-sm text-charcoal/60">Every stitch matters</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Categories Section -->
    <div class="py-24 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-terracotta font-serif text-lg tracking-widest uppercase">Explore Categories</span>
          <h2 class="font-serif text-5xl text-charcoal mt-4 mb-6">What I Create</h2>
          <div class="w-32 h-1 bg-gradient-to-r from-terracotta to-rose-gold mx-auto rounded-full"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Category 1 -->
          <div class="group relative overflow-hidden rounded-3xl">
            <div class="aspect-[4/5] overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?w=600&h=750&fit=crop"
                alt="Blankets"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
              <div>
                <h3 class="font-serif text-3xl text-white mb-2">Blankets</h3>
                <p class="text-white/80 font-sans">Cozy warmth for every season</p>
              </div>
            </div>
          </div>

          <!-- Category 2 -->
          <div class="group relative overflow-hidden rounded-3xl">
            <div class="aspect-[4/5] overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?w=600&h=750&fit=crop"
                alt="Amigurumi"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
              <div>
                <h3 class="font-serif text-3xl text-white mb-2">Amigurumi</h3>
                <p class="text-white/80 font-sans">Adorable stuffed friends</p>
              </div>
            </div>
          </div>

          <!-- Category 3 -->
          <div class="group relative overflow-hidden rounded-3xl">
            <div class="aspect-[4/5] overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1615486360331-8a4c4d8e9b3f?w=600&h=750&fit=crop"
                alt="Accessories"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
              <div>
                <h3 class="font-serif text-3xl text-white mb-2">Accessories</h3>
                <p class="text-white/80 font-sans">Wearable art pieces</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Projects with Masonry Layout -->
    <div id="gallery" class="py-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-cream-50 to-champagne-50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-terracotta font-serif text-lg tracking-widest uppercase">Featured Work</span>
          <h2 class="font-serif text-5xl text-charcoal mt-4 mb-6">Latest Creations</h2>
          <div class="w-32 h-1 bg-gradient-to-r from-terracotta to-rose-gold mx-auto rounded-full"></div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 auto-rows-[200px]">
          <!-- Large Item -->
          <div class="col-span-2 row-span-2 group relative overflow-hidden rounded-3xl">
            <img
              src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?w=800&h=800&fit=crop"
              alt="Featured blanket"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
              <div>
                <span class="text-terracotta text-sm font-medium uppercase tracking-wider">Featured</span>
                <h3 class="font-serif text-2xl text-white">Autumn Dreams Blanket</h3>
              </div>
            </div>
          </div>

          <!-- Small Items -->
          <div class="group relative overflow-hidden rounded-3xl">
            <img
              src="https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?w=400&h=400&fit=crop"
              alt="Amigurumi"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-4">
              <h3 class="font-serif text-lg text-white">Bunny Friend</h3>
            </div>
          </div>

          <div class="group relative overflow-hidden rounded-3xl">
            <img
              src="https://images.unsplash.com/photo-1615486360331-8a4c4d8e9b3f?w=400&h=400&fit=crop"
              alt="Scarf"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-4">
              <h3 class="font-serif text-lg text-white">Winter Scarf</h3>
            </div>
          </div>

          <!-- Wide Item -->
          <div class="col-span-2 group relative overflow-hidden rounded-3xl">
            <img
              src="https://images.unsplash.com/photo-1596464716127-f2a82984de30?w=800&h=400&fit=crop"
              alt="Process"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
              <div>
                <span class="text-terracotta text-sm font-medium uppercase tracking-wider">Behind the Scenes</span>
                <h3 class="font-serif text-xl text-white">The Creative Process</h3>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- About Section with Timeline -->
    <div id="about" class="py-24 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <!-- Image Side -->
          <div class="relative">
            <div class="sticky top-8">
              <img
                src="https://images.unsplash.com/photo-1596464716127-f2a82984de30?w=800&h=1000&fit=crop"
                alt="My journey"
                class="rounded-3xl shadow-2xl w-full"
              />
              <div class="absolute -bottom-8 -right-8 bg-gradient-to-br from-terracotta to-rose-gold rounded-2xl p-8 text-white shadow-xl">
                <div class="font-serif text-5xl mb-2">5+</div>
                <div class="text-sm uppercase tracking-wider">Years of Crafting</div>
              </div>
            </div>
          </div>

          <!-- Content Side -->
          <div class="space-y-12">
            <div>
              <span class="text-terracotta font-serif text-lg tracking-widest uppercase">My Journey</span>
              <h2 class="font-serif text-5xl text-charcoal mt-4 mb-6">
                From Hobby to<br />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-terracotta to-rose-gold">Passion</span>
              </h2>
              <div class="w-32 h-1 bg-gradient-to-r from-terracotta to-rose-gold rounded-full"></div>
            </div>

            <p class="text-charcoal/70 text-lg font-sans leading-relaxed">
              My crochet journey began on a rainy afternoon when I picked up my first hook and a ball of yarn. What started as a simple way to pass time quickly blossomed into an all-consuming passion. There's something magical about transforming a humble strand of yarn into something beautiful, functional, and full of love.
            </p>

            <!-- Timeline -->
            <div class="space-y-8">
              <div class="flex gap-6">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 bg-terracotta/10 rounded-full flex items-center justify-center">
                    <div class="w-4 h-4 bg-terracotta rounded-full"></div>
                  </div>
                  <div class="w-0.5 h-full bg-terracotta/20 mt-2"></div>
                </div>
                <div class="pb-8">
                  <h3 class="font-serif text-xl text-charcoal mb-2">The Beginning</h3>
                  <p class="text-charcoal/60 font-sans">Started with simple scarves and basic stitches, learning the foundations of crochet.</p>
                </div>
              </div>

              <div class="flex gap-6">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 bg-rose-gold/10 rounded-full flex items-center justify-center">
                    <div class="w-4 h-4 bg-rose-gold rounded-full"></div>
                  </div>
                  <div class="w-0.5 h-full bg-rose-gold/20 mt-2"></div>
                </div>
                <div class="pb-8">
                  <h3 class="font-serif text-xl text-charcoal mb-2">Discovering Amigurumi</h3>
                  <p class="text-charcoal/60 font-sans">Fell in love with creating adorable stuffed toys and learned intricate techniques.</p>
                </div>
              </div>

              <div class="flex gap-6">
                <div class="flex flex-col items-center">
                  <div class="w-12 h-12 bg-champagne/20 rounded-full flex items-center justify-center">
                    <div class="w-4 h-4 bg-champagne rounded-full"></div>
                  </div>
                </div>
                <div>
                  <h3 class="font-serif text-xl text-charcoal mb-2">Sharing the Joy</h3>
                  <p class="text-charcoal/60 font-sans">Started sharing patterns and creations, building a community of fellow crafters.</p>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-6 pt-8">
              <div class="bg-cream-50 rounded-2xl p-6">
                <div class="text-3xl font-serif text-terracotta mb-2">Premium</div>
                <div class="text-charcoal/60 text-sm">Quality Materials</div>
              </div>
              <div class="bg-cream-50 rounded-2xl p-6">
                <div class="text-3xl font-serif text-rose-gold mb-2">Custom</div>
                <div class="text-charcoal/60 text-sm">Made to Order</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Testimonials Section -->
    <div class="py-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-terracotta/10 via-rose-gold/10 to-champagne/10">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-terracotta font-serif text-lg tracking-widest uppercase">Happy Customers</span>
          <h2 class="font-serif text-5xl text-charcoal mt-4 mb-6">What People Say</h2>
          <div class="w-32 h-1 bg-gradient-to-r from-terracotta to-rose-gold mx-auto rounded-full"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white rounded-3xl p-8 shadow-lg">
            <div class="flex gap-1 mb-4">
              <svg class="w-5 h-5 text-terracotta" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 text-terracotta" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 text-terracotta" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 text-terracotta" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 text-terracotta" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <p class="text-charcoal/70 font-sans mb-6 leading-relaxed">"The blanket I ordered is absolutely stunning. The quality is incredible and you can feel the love in every stitch."</p>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-terracotta/20 rounded-full"></div>
              <div>
                <div class="font-semibold text-charcoal">Sarah M.</div>
                <div class="text-charcoal/60 text-sm">Blanket Order</div>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-3xl p-8 shadow-lg">
            <div class="flex gap-1 mb-4">
              <svg class="w-5 h-5 text-terracotta" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 text-terracotta" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
